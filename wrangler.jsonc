{
  "name": "civitai-r2-import-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "LORA_BUCKET",
      "bucket_name": "civitai-lora-test"
    },
    {
      "binding": "PRODUCTION_LORA_BUCKET",
      "bucket_name": "minimax-h3-videos"
    }
  ]
}
